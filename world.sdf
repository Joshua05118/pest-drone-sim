<?xml version="1.0"?>
<sdf version="1.10">
  <world name="workbench">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.4 0.2 -1</direction>
    </light>
    <model name="floor">
      <static>true</static>
      <link name="base">
        <collision name="surface"><geometry><box><size>10 10 0.1</size></box></geometry></collision>
        <visual name="surface"><geometry><box><size>10 10 0.1</size></box></geometry></visual>
      </link>
    </model>
    <model name="ball">
      <pose>0 0 2 0 0 0</pose>
      <link name="body">
        <inertial>
          <mass>1</mass>
          <inertia><ixx>0.025</ixx><iyy>0.025</iyy><izz>0.025</izz></inertia>
        </inertial>
        <collision name="ball"><geometry><sphere><radius>0.25</radius></sphere></geometry></collision>
        <visual name="ball">
          <geometry><sphere><radius>0.25</radius></sphere></geometry>
          <material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
